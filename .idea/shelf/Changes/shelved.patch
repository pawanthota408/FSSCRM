+            if (raw.isBlank()) return "HTTP ${response.code()}"
+            val obj = gson.fromJson(raw, JsonObject::class.java)
+            when {
+                obj.has("message") && !obj.get("message").isJsonNull ->
+                    obj.get("message").asString
+                else -> raw.take(200)
+            }
+        } catch (_: Exception) {
+            "HTTP ${response.code()}"
