+                                    OutlinedTextField(prodSerial, { prodSerial = it }, Modifier.weight(1f), label = { Text("Licence / Serial #", fontSize = 10.sp) })
+                                    Button(onClick = {
+                                        val p = selProd
+                                        if (p != null && prodCost.isNotBlank()) {
+                                            items.add(QuoteRequirement(p.name, prodCost, p.id, serial_number = prodSerial))
+                                            selProd = null
