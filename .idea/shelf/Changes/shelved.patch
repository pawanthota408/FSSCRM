+@Composable
+fun CallOverlayContent(
+    phoneNumber: String,
+    callType: String,
+    onDismiss: () -> Unit
+) {
+    val context = LocalContext.current
+    var identifiedLead by remember { mutableStateOf<Lead?>(null) }
+    var identifiedCustomer by remember { mutableStateOf<Customer?>(null) }
+    var leadDetails by remember { mutableStateOf<LeadDetailsResponse?>(null) }
+    var loading by remember { mutableStateOf(true) }
+
+    LaunchedEffect(phoneNumber) {
+        loading = true
+        if (phoneNumber.isNotBlank() && phoneNumber != "Unknown") {
+            try {
+                val userId = SessionManager(context).getUserId()
+                if (userId != 0) {
+                    // Normalize phone for match (last 10 digits)
+                    fun norm(p: String?) = p?.replace(Regex("[^0-9]"), "")?.takeLast(10).orEmpty()
+                    val target = norm(phoneNumber)
+
+                    val leadsResponse = RetrofitClient.apiService.getLeads(mapOf("user_id" to userId))
+                    if (leadsResponse.isSuccessful && leadsResponse.body() != null) {
+                        val json = leadsResponse.body()!!
+                        val leadsList: List<Lead> = when {
+                            json.isJsonArray -> Gson().fromJson(
+                                json,
+                                object : TypeToken<List<Lead>>() {}.type
+                            )
+                            json.isJsonObject && json.asJsonObject.has("leads") ->
+                                Gson().fromJson(json, LeadResponse::class.java).leads ?: emptyList()
+                            else -> emptyList()
+                        }
+                        identifiedLead = leadsList.find {
+                            val n = norm(it.phone)
+                            n.isNotEmpty() && (n == target || n.contains(target) || target.contains(n))
+                        }
+                    }
+
+                    if (identifiedLead == null) {
+                        val custResponse = RetrofitClient.apiService.getCustomers(
+                            mapOf("user_id" to userId.toString(), "query" to phoneNumber)
+                        )
+                        if (custResponse.isSuccessful && custResponse.body() != null) {
+                            val json = custResponse.body()!!
+                            val customersList: List<Customer> = when {
+                                json.isJsonArray -> Gson().fromJson(
+                                    json,
+                                    object : TypeToken<List<Customer>>() {}.type
+                                )
+                                json.isJsonObject && json.asJsonObject.has("customers") ->
+                                    Gson().fromJson(
+                                        json.asJsonObject.get("customers"),
+                                        object : TypeToken<List<Customer>>() {}.type
+                                    )
+                                else -> emptyList()
+                            }
+                            identifiedCustomer = customersList.find {
+                                val n = norm(it.phone)
+                                n.isNotEmpty() && (n == target || n.contains(target) || target.contains(n))
+                            }
+                        }
+                    }
+
+                    identifiedLead?.let { lead ->
+                        val detailsResp = RetrofitClient.apiService.getLeadDetails(
+                            mapOf("lead_id" to lead.id)
+                        )
+                        if (detailsResp.isSuccessful && detailsResp.body() != null) {
+                            leadDetails = Gson().fromJson(
+                                detailsResp.body()!!,
+                                LeadDetailsResponse::class.java
+                            )
+                        }
+                    }
+                }
+            } catch (e: Exception) {
+                Log.e("CallOverlayContent", "Search error: ${e.message}", e)
+            }
+        }
+        loading = false
+    }
+
+    if (callType == "Post Call") {
+        PostCallLayout(
+            phoneNumber = phoneNumber,
+            lead = identifiedLead,
+            customer = identifiedCustomer,
+            details = leadDetails,
+            loading = loading,
+            onDismiss = onDismiss
+        )
+    } else {
+        ActiveCallLayout(
+            phoneNumber = phoneNumber,
+            lead = identifiedLead,
+            customer = identifiedCustomer,
+            details = leadDetails,
+            type = callType,
+            onDismiss = onDismiss
+        )
+    }
+}
