+                    Text(item.amount, fontWeight = FontWeight.Bold, fontSize = 13.sp)
+                }
+                if (item.status.isNotBlank()) {
+                    Text(item.status, fontSize = 11.sp, color = PrimaryIndigo)
+                }
+            }
+        }
+    }
+}
