+                        title = "No Results Found",
+                        message = "No customers found matching \"$searchQuery\"",
+                        buttonText = "Clear Search",
+                        onButtonClick = {
+                            searchQuery = ""
+                            loadCustomers()
+                        }
+                    )
+                }
+
+                else -> {
+                    LazyColumn(
+                        state = listState,
