+                else -> root
+            }
+            val customerJson = when {
+                dataObj.has("customer") && dataObj.get("customer").isJsonObject ->
+                    dataObj.getAsJsonObject("customer")
+                dataObj.has("id") -> dataObj
+                else -> dataObj
+            }
