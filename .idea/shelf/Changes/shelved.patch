+                    val json = response.body()!!
+                    if (json.isJsonArray) {
+                        customers = com.google.gson.Gson().fromJson(json, object : com.google.gson.reflect.TypeToken<List<Customer>>() {}.type)
+                    } else if (json.isJsonObject) {
