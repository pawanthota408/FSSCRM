+                                onClick = {
+                                    navController.navigate("customer_details/${customer.id}")
+                                }
+                            )
+                        }
+
+                        // Loading more indicator
+                        if (isLoadingMore) {
+                            item {
+                                Box(
+                                    modifier = Modifier
+                                        .fillMaxWidth()
+                                        .padding(16.dp),
+                                    contentAlignment = Alignment.Center
+                                ) {
+                                    Row(horizontalArrangement = Arrangement.Center) {
