+
+        try {
+            showOverlay(phoneNumber, callType)
+        } catch (e: Exception) {
+            Log.e(TAG, "showOverlay failed: ${e.message}", e)
+            stopSafely()
+        }
+
+        return START_NOT_STICKY
+    }
