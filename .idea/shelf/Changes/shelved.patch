+}
+
+@Composable
+fun EnhancedActivityCard(activity: ActivityLog, onClick: () -> Unit) {
+    Card(
+        modifier = Modifier.fillMaxWidth().clickable(onClick = onClick),
+        shape = RoundedCornerShape(20.dp),
