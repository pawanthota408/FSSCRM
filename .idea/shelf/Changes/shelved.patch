+                                    Spacer(modifier = Modifier.height(8.dp))
+                                    Text(ann.date, fontSize = 10.sp, color = Color.Gray, modifier = Modifier.align(Alignment.End))
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
