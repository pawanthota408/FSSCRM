+                    }
+
+                val worksActivity = worksForService.mapIndexed { i, o ->
+                    LicenseHistoryItem(
+                        id = o.get("id")?.takeIf { !it.isJsonNull }?.asInt ?: (3000 + i),
+                        title = jsonStr(o, "work_name", "name", "lead_name").ifBlank { "Work" },
+                        subtitle = listOf(
